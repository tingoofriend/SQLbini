; Engine configuration file.
; Scaffolded by /setup-engine for Godot 4.7.2 (Forward+, 2D UI game).
; run/main_scene is intentionally unset: /dev-story or the developer sets it
; once the first scene exists.

config_version=5

[application]

config/name="SQLbini"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="forward_plus"
